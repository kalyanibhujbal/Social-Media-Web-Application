{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "description": "Python/FastAPI backend. These scripts only wrap the Python commands so npm works from this folder.",
  "scripts": {
    "postinstall": "python -m pip install -r requirements.txt",
    "setup": "python -m pip install -r requirements.txt",
    "dev": "python -m uvicorn main:app --reload --port 8000",
    "start": "python -m uvicorn main:app --port 8000",
    "test": "python -m unittest discover -s tests"
  }
}
