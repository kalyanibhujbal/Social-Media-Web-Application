# AI-Driven Social Media Content Moderation Environment Variables Example
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# Application Settings
PROJECT_NAME="AI Content Moderation with Explainable Hate Speech Detection"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="social_moderation_db"

# Security & Authentication
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional administrator bootstrap. Leave unset unless an operator supplies
# unique credentials; no demo account is created by default.
# INITIAL_ADMIN_EMAIL="admin@example.com"
# INITIAL_ADMIN_PASSWORD="use-a-unique-long-secret"

# Browser origins allowed to use the HttpOnly session cookie
FRONTEND_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Model & Inference Settings
DEFAULT_MODEL_NAME="distilbert-base-uncased-finetuned-sst-2-english"
MODEL_LOCAL_FILES_ONLY=true
CONFIDENCE_THRESHOLD_HIGH=0.80
CONFIDENCE_THRESHOLD_LOW=0.50

# Responsible AI & Transparency
EXPLAINABILITY_ENABLED=true
MAX_EXPLANATION_TOP_K=5

# Retention settings (days)
AUDIT_RETENTION_DAYS=365
RESOLVED_PRIVACY_REQUEST_RETENTION_DAYS=365
PRIVACY_POLICY_VERSION="1.0"

# Operator contact placeholders; replace and verify before public deployment
ORGANIZATION_NAME="[PROJECT / ORGANIZATION NAME]"
OFFICIAL_EMAIL="[OFFICIAL EMAIL]"
OFFICIAL_ADDRESS="[OFFICIAL ADDRESS]"
GRIEVANCE_CONTACT="[GRIEVANCE CONTACT EMAIL]"
